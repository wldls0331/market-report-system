# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=

# Local Windows only. Cloud/Render uses the GOOGLE_* and GMAIL_* variables below.
GOOGLE_CREDENTIALS_FILE=credentials.json
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GOOGLE_SHEETS_TOKEN_FILE=sheets_token.json

# Render Environment Variables (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail send-only OAuth. Use a Gmail refresh token, not the Sheets token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
