# Copy into Streamlit Community Cloud: App settings → Secrets.
# Do not commit secrets.toml or real tokens.
#
# Quote every value. refresh_token MUST be quoted because // starts a TOML comment.

[google]
sheet_id = "PASTE_SPREADSHEET_ID"
sheet_url = "https://docs.google.com/spreadsheets/d/PASTE_SPREADSHEET_ID/edit"
client_id = "PASTE_FROM_credentials.json_installed.client_id"
client_secret = "PASTE_FROM_credentials.json_installed.client_secret"
refresh_token = "PASTE_FROM_sheets_token.json_refresh_token"

[gmail]
client_id = ""
client_secret = ""
refresh_token = ""
